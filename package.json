{
  "name": "finfly",
  "version": "1.0.0",
  "type": "module",
  "description": "A portfolio MVP for corporate flight-report and expense approvals built with SAP CAP and Fiori elements.",
  "dependencies": {
    "@cap-js/postgres": "^2.3.3",
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/attachments": "^4.0.0",
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.15.0",
    "@cap-js/sqlite": "^2.4.0",
    "@types/node": "^24.0.0",
    "brace-expansion": "^1.1.21",
    "cds-plugin-ui5": "^0.13.0",
    "eslint": "^10.8.1",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "tsx scripts/start-server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint srv scripts test --max-warnings 0 && npm run lint --workspace=app/flightreports && npm run lint --workspace=app/audit && npm run lint --workspace=app/admin",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:ui": "npm run build --workspace=app/flightreports && npm run build --workspace=app/audit && npm run build --workspace=app/admin",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "watch-flightreports": "cds watch --open finfly.flightreports/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "workspaces": [
    "app/*"
  ],
  "overrides": {
    "minimatch@10.2.6": {
      "brace-expansion": "5.0.12"
    },
    "proxy-addr": "2.0.8",
    "qs": "6.16.0"
  },
  "sapux": [
    "app/flightreports",
    "app/audit"
  ],
  "cds": {
    "finfly": {
      "selfApprovalEnabled": true
    },
    "requires": {
      "ExchangeRateService": {
        "kind": "odata",
        "model": "srv/external/exchange-rate-service"
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "pilot": {
            "password": "pilot",
            "attr": {
              "organization": "50000000-0000-0000-0000-000000000001"
            },
            "roles": [
              "Pilot"
            ]
          },
          "auditor": {
            "password": "auditor",
            "attr": {
              "organization": "50000000-0000-0000-0000-000000000001"
            },
            "roles": [
              "Auditor"
            ]
          },
          "admin": {
            "password": "admin",
            "attr": {
              "organization": "50000000-0000-0000-0000-000000000001"
            },
            "roles": [
              "Admin",
              "Pilot",
              "Auditor"
            ]
          },
          "otherpilot": {
            "password": "otherpilot",
            "attr": {
              "organization": "50000000-0000-0000-0000-000000000002"
            },
            "roles": [
              "Pilot"
            ]
          },
          "*": false
        }
      }
    },
    "[production]": {
      "requires": {
        "auth": {
          "impl": "srv/auth/authentication.ts"
        }
      }
    }
  }
}
