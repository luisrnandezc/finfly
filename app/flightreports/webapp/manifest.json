{
  "_version": "1.83.0",
  "sap.app": {
    "id": "finfly.flightreports",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.22.0",
      "toolsId": "0ca4bcf9-2d20-4359-a1a8-28382fcc1a32"
    },
    "dataSources": {
      "mainService": {
        "uri": "/expenses/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.01"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.151.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "finfly.flightreports.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "FlightReportsList",
          "target": "FlightReportsList"
        },
        {
          "pattern": "FlightReports({key}):?query:",
          "name": "FlightReportsObjectPage",
          "target": "FlightReportsObjectPage"
        }
      ],
      "targets": {
        "FlightReportsList": {
          "type": "Component",
          "id": "FlightReportsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/FlightReports",
              "variantManagement": "Page",
              "views": {
                "paths": [
                  {
                    "key": "needsAttention",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#NeedsAttention"
                  },
                  {
                    "key": "pendingAudit",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#PendingAudit"
                  },
                  {
                    "key": "approved",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Approved"
                  },
                  {
                    "key": "allReports",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#AllReports"
                  }
                ]
              },
              "navigation": {
                "FlightReports": {
                  "detail": {
                    "route": "FlightReportsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "FlightReportsObjectPage": {
          "type": "Component",
          "id": "FlightReportsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/FlightReports",
              "enhanceI18n": "i18n/i18n.properties"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
